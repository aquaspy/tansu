package views

import "fmt"

// NoteList is the notes column; re-rendered for search and autosaves.
templ NoteList(p Page, d ShellData) {
	<div id="notes_list" class="note-list" data-controller="confirm">
		if len(d.Notes) == 0 {
			<p class="muted empty-list">{ p.T("js.empty_list") }</p>
		} else {
			for _, n := range d.Notes {
				<div class={ noteItemClass(n.Active) }>
					<a href={ templ.SafeURL(NoteHref(n.ID, d.Filters)) } class="note-item-link">
						<strong>{ n.Title }</strong>
						<span>{ n.Preview }</span>
					</a>
					<button
						type="button"
						class="icon-btn danger note-delete"
						data-action="confirm#open"
						data-url={ fmt.Sprintf("/notes/%d", n.ID) }
						data-redirect={ NotesHref(d.Folder, d.Query) }
						data-message={ p.T("js.delete_confirm") }
						title={ p.T("app.delete") }
						aria-label={ p.T("app.delete") }
					>
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 4.4h9.6M6.2 4.4V3.2h3.6v1.2M5.1 6.2l.4 6.2h5l.4-6.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</button>
				</div>
			}
			<dialog class="confirm-dialog" data-confirm-target="box" data-action="click->confirm#backdrop">
				<p data-confirm-target="message">{ p.T("js.delete_confirm") }</p>
				<div class="confirm-actions">
					<button type="button" class="btn-dialog" data-action="confirm#close">{ p.T("app.cancel") }</button>
					<button type="button" class="btn-dialog danger" data-confirm-target="destroy">{ p.T("app.delete") }</button>
				</div>
			</dialog>
		}
	</div>
}

func noteItemClass(active bool) string {
	if active {
		return "note-item is-on"
	}
	return "note-item"
}

// NoteUpdateResponse refreshes the list, the folders nav, and the folder
// picker after an autosave (all out-of-band; the form swaps none).
templ NoteUpdateResponse(p Page, d ShellData) {
	<div hx-swap-oob="outerHTML:#notes_list">
		@NoteList(p, d)
	</div>
	<div hx-swap-oob="outerHTML:#folders_nav">
		@FoldersNav(p, d)
	</div>
	<div hx-swap-oob="innerHTML:#folder_picker_list">
		@FolderPickerOptions(p, d)
	</div>
}
