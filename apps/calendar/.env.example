# Copy to .env and fill in. Then:
#   docker compose up -d --build
# After editing .env, apply with:
#   docker compose up -d
# (compose restart keeps the old env; up -d recreates the container.)

# Public signup form. true for the first account, then flip to false.
SIGNUP_ENABLED=true

# Set true when your own Caddy/nginx terminates HTTPS in front.
FORCE_SSL=false

# Your public hostname. Comma-separated if you have more than one.
# Leave empty only while testing.
KURA_HOST=calendar.gettansu.com

# Publish only on localhost so 80/443 stay free for your proxy.
# Point Caddy or nginx at 127.0.0.1:3003.
BIND=127.0.0.1:3003

# Tansu Account SSO (optional). Set all three to offer "Entrar com Tansu"
# next to the standalone password login; leave unset for standalone-only.
# Register this app's redirect URI (KURA_HOST + /login/kura/callback)
# in the account's KURA_CLIENTS_JSON with the same client id + secret.
#KURA_ACCOUNT_URL=https://account.gettansu.com
#KURA_CLIENT_ID=kuracalendar
#KURA_CLIENT_SECRET=change-me-to-16plus-chars
