package views

templ AgentError(p Page) {
	<section class="auth-card">
		if p.Alert != "" {
			<p class="flash flash-alert" role="alert">{ p.Alert }</p>
		}
		@Wordmark()
		<h1>{ p.T("agent.title") }</h1>
	</section>
}

templ AgentConfirm(p Page, email, redirectURI, state, challenge string) {
	<section class="auth-card">
		if p.Alert != "" {
			<p class="flash flash-alert" role="alert">{ p.Alert }</p>
		}
		@Wordmark()
		<h1>{ p.T("agent.title") }</h1>
		<p class="lede">{ p.T("agent.lede") }</p>
		<p class="lede">{ p.T("agent.session", "email", email) }</p>
		<form action="/agent/connect" method="post" class="auth-form">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<input type="hidden" name="redirect_uri" value={ redirectURI }/>
			<input type="hidden" name="state" value={ state }/>
			<input type="hidden" name="code_challenge" value={ challenge }/>
			<input type="submit" value={ p.T("agent.confirm") } class="btn-primary"/>
		</form>
	</section>
}
