package views

import (
	"strconv"
	"strings"

	"github.com/aquasp/kuracalendar/internal/i18n"
	"github.com/aquasp/kuracalendar/internal/store"
)

templ FeedsPage(p Page, list []*store.ICSFeed) {
	<section class="auth-card feeds-card">
		if p.Notice != "" {
			<p class="flash flash-notice" role="status">{ p.Notice }</p>
		}
		if p.Alert != "" {
			<p class="flash flash-alert" role="alert">{ p.Alert }</p>
		}
		@Wordmark(p)
		<h1>{ p.T("feeds.title") }</h1>
		<p class="lede">{ p.T("feeds.lede") }</p>
		@TimezoneForm(p)
		<form action="/feeds" method="post" class="auth-form">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<label>
				{ p.T("feeds.name_label") }
				<input type="text" name="name" required maxlength="80" autocomplete="off" placeholder={ p.T("feeds.name_placeholder") }/>
			</label>
			<label>
				{ p.T("feeds.url_label") }
				<input type="url" name="url" required maxlength="2048" autocomplete="off" spellcheck="false" placeholder={ p.T("feeds.url_placeholder") }/>
			</label>
			<p class="field-hint">{ p.T("feeds.url_hint") }</p>
			<input type="submit" value={ p.T("feeds.add") } class="btn-primary"/>
		</form>
		<h2 class="tokens-heading">{ p.T("feeds.existing") }</h2>
		if len(list) > 0 {
			<ul class="token-list">
				for _, f := range list {
					<li class="token-row feed-row">
						<div class="token-meta">
							<strong>{ f.Name }</strong>
							<span class="field-hint">{ FeedMeta(p, f) }</span>
							if f.ErrorKey() != "" {
								<span class="feed-error">{ p.T(f.ErrorKey()) }</span>
							}
						</div>
						<div class="feed-actions">
							<form action={ templ.SafeURL(FeedPath(f.ID, "refresh")) } method="post">
								<input type="hidden" name="csrf_token" value={ p.CSRF }/>
								<button type="submit" class="btn-dialog">{ p.T("feeds.refresh") }</button>
							</form>
							<form action={ templ.SafeURL(FeedPath(f.ID, "pause")) } method="post">
								<input type="hidden" name="csrf_token" value={ p.CSRF }/>
								<button type="submit" class="btn-dialog">
									if f.Paused {
										{ p.T("feeds.resume") }
									} else {
										{ p.T("feeds.pause") }
									}
								</button>
							</form>
							<form
								action={ templ.SafeURL(FeedPath(f.ID, "delete")) }
								method="post"
								data-controller="confirm"
								data-action="submit->confirm#ask"
								data-confirm-message={ p.T("feeds.remove_confirm") }
							>
								<input type="hidden" name="csrf_token" value={ p.CSRF }/>
								<button type="submit" class="btn-dialog danger">{ p.T("feeds.remove") }</button>
							</form>
						</div>
					</li>
				}
			</ul>
		} else {
			<p class="lede">{ p.T("feeds.empty") }</p>
		}
		<p class="auth-foot"><a href="/">{ p.T("app.cancel") }</a></p>
		@ThemeSwitch(p)
	</section>
}

func FeedPath(id int64, action string) string {
	return "/feeds/" + strconv.FormatInt(id, 10) + "/" + action
}

func FeedMeta(p Page, f *store.ICSFeed) string {
	parts := make([]string, 0, 4)
	if h := f.Host(); h != "" {
		parts = append(parts, h)
	}
	parts = append(parts, p.T("feeds.events", "count", strconv.Itoa(f.EventCount)))
	if f.Paused {
		parts = append(parts, p.T("feeds.paused"))
	}
	if f.LastFetchedAt != nil {
		parts = append(parts, p.T("feeds.last_sync")+" "+i18n.TimeShort(p.L, *f.LastFetchedAt, p.Zone))
	} else {
		parts = append(parts, p.T("feeds.never"))
	}
	return strings.Join(parts, " · ")
}

templ TimezoneForm(p Page) {
	<section class="zone-block">
		<h2 class="tokens-heading">{ p.T("zone.title") }</h2>
		if p.ZoneLocked {
			<p class="lede">{ p.T("zone.managed") } <strong>{ p.Timezone }</strong></p>
			if p.AccountURL != "" {
				<p class="auth-foot"><a href={ templ.SafeURL(p.AccountURL) }>{ p.T("zone.account") }</a></p>
			}
		} else {
			<p class="lede">{ p.T("zone.lede") }</p>
			<form action="/timezone" method="post" class="auth-form">
				<input type="hidden" name="csrf_token" value={ p.CSRF }/>
				<label>
					{ p.T("zone.label") }
					<input type="text" name="timezone" value={ p.Timezone } maxlength="64" autocomplete="off" spellcheck="false" placeholder="America/Sao_Paulo"/>
				</label>
				<input type="submit" value={ p.T("zone.save") } class="btn-primary"/>
			</form>
		}
	</section>
}
