package views

import "strconv"

func idStr(id int64) string { return strconv.FormatInt(id, 10) }

func onOff(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func viewTabClass(on bool) string {
	if on {
		return "view-tab is-on"
	}
	return "view-tab"
}

func profileTabClass(on bool) string {
	if on {
		return "profile-tab is-on"
	}
	return "profile-tab"
}

templ Flashes(p Page) {
	if p.Notice != "" {
		<p class="flash flash-notice" role="status">{ p.Notice }</p>
	}
	if p.Alert != "" {
		<p class="flash flash-alert" role="alert">{ p.Alert }</p>
	}
}

templ LockNow(p Page) {
	<form id="lock-now-form" action="/lock" method="post">
		<input type="hidden" name="csrf_token" value={ p.CSRF }/>
		<button type="submit" id="lock-now" class="sr-only" tabindex="-1" aria-hidden="true"></button>
	</form>
}

templ IndexPage(p Page, d HomeData) {
	@LockNow(p)
	@Flashes(p)
	<div
		class="home"
		data-controller="lock offline menu clock edit dialog"
		data-lock-enabled-value={ onOff(d.AutoLock) }
		data-lock-on-label-value={ p.T("app.auto_lock_on") }
		data-lock-off-label-value={ p.T("app.auto_lock_off") }
	>
		@Header(p, d)
		<main class="home-inner">
			<p class="greeting" data-clock-target="greeting">{ p.T("js.morning") }</p>
			<time class="when" data-clock-target="clock"></time>
			<form class="omnibox" action="https://duckduckgo.com/" method="get" target="_blank" rel="noopener noreferrer" data-controller="search">
				<input type="search" name="q" data-search-target="query" placeholder={ p.T("js.search_placeholder") } autocomplete="off" enterkeyhint="search" aria-label={ p.T("js.search_placeholder") }/>
				<button type="button" class="engine-btn" data-search-target="engine" data-action="search#cycle">DuckDuckGo</button>
			</form>
			@Profiles(p, d)
			if len(d.Sites) == 0 {
				<section class="empty">
					<h1>{ p.T("app.empty_title") }</h1>
					<p>{ p.T("app.empty_lede") }</p>
					<button
						type="button"
						class="btn-primary empty-add"
						data-action="dialog#openSite"
						data-heading={ p.T("app.add_site") }
						data-profile-id={ idStr(d.Profile.ID) }
						data-site-id=""
						data-title=""
						data-url=""
						data-hint=""
						data-icon-url=""
					>
						{ p.T("app.add_site") }
					</button>
				</section>
			} else {
				<ul class="tiles" data-controller="sort" data-sort-url-value={ d.ReorderURL }>
					for _, site := range d.Sites {
						<li class="tile-wrap" draggable="true" data-id={ idStr(site.ID) } data-action="dragstart->sort#start dragover->sort#over drop->sort#drop dragend->sort#end">
							<a class="tile" href={ templ.SafeURL(site.URL) } target="_blank" rel="noopener noreferrer">
								@Mark(site.IconSrc(), site.Letter(), site.Color(), "lg")
								<span class="tile-copy">
									<strong>{ site.Title }</strong>
									<em>{ site.HintOrHost() }</em>
								</span>
							</a>
							<div class="tile-actions edit-only">
								<button
									type="button"
									class="tile-edit"
									data-action="dialog#openSite"
									data-heading={ p.T("app.edit_site") }
									data-profile-id={ idStr(d.Profile.ID) }
									data-site-id={ idStr(site.ID) }
									data-title={ site.Title }
									data-url={ site.URL }
									data-hint={ site.Hint }
									data-icon-url={ site.IconURL }
									aria-label={ p.T("app.edit_site") }
								>
									<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.4 3.2 12.8 5.6 6.2 12.2H3.8v-2.4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>
								</button>
								<form class="tile-delete-form" action={ "/sites/" + idStr(site.ID) } method="post" data-controller="confirm" data-action="submit->confirm#ask" data-confirm-message={ p.T("js.delete_site_confirm") }>
									<input type="hidden" name="csrf_token" value={ p.CSRF }/>
									<input type="hidden" name="_method" value="delete"/>
									<button type="submit" class="tile-edit is-danger" aria-label={ p.T("app.delete") }>
										<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 4.3h9M6.2 4.3V3.4h3.6v.9M5.3 6.4v5.2M8 6.4v5.2M10.7 6.4v5.2M4.6 4.3l.55 8.1h5.7l.55-8.1" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
									</button>
								</form>
							</div>
						</li>
					}
					<li class="tile-wrap">
						<button
							type="button"
							class="tile tile-add"
							data-action="dialog#openSite"
							data-heading={ p.T("app.add_site") }
							data-profile-id={ idStr(d.Profile.ID) }
							data-site-id=""
							data-title=""
							data-url=""
							data-hint=""
							data-icon-url=""
						>
							<span class="mark mark-lg add-mark">+</span>
							<span class="tile-copy">
								<strong>{ p.T("app.add_site") }</strong>
							</span>
						</button>
					</li>
				</ul>
			}
		</main>
		<button
			type="button"
			class="fab"
			data-action="dialog#openSite"
			data-heading={ p.T("app.add_site") }
			data-profile-id={ idStr(d.Profile.ID) }
			data-site-id=""
			data-title=""
			data-url=""
			data-hint=""
			data-icon-url=""
			aria-label={ p.T("app.add_site") }
		>
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
		</button>
		@SiteDialog(p, d)
		@ProfileDialog(p, d)
	</div>
}

templ StackPage(p Page, d HomeData) {
	@LockNow(p)
	@Flashes(p)
	<div
		class="home"
		data-controller="lock offline menu edit dialog"
		data-lock-enabled-value={ onOff(d.AutoLock) }
		data-lock-on-label-value={ p.T("app.auto_lock_on") }
		data-lock-off-label-value={ p.T("app.auto_lock_off") }
	>
		@Header(p, d)
		<main
			class="home-inner is-stack"
			data-controller="share"
			data-share-title-value={ p.T("app.stack_title") }
			data-share-profile-value={ d.Profile.Name }
			data-share-footer-value="TansuHome"
		>
			<header class="stack-head">
				<div>
					<h1>{ p.T("app.stack_title") }</h1>
					<p>{ p.T("app.stack_lede") }</p>
				</div>
				if len(d.Items) > 0 {
					<button type="button" class="text-btn share-btn" data-action="share#download">{ p.T("app.share_stack") }</button>
				}
			</header>
			@Profiles(p, d)
			if len(d.Items) == 0 {
				<section class="empty">
					<h1>{ p.T("app.stack_empty_title") }</h1>
					<p>{ p.T("app.stack_empty_lede") }</p>
					<button
						type="button"
						class="btn-primary empty-add"
						data-action="dialog#openStack"
						data-heading={ p.T("app.add_stack_item") }
						data-profile-id={ idStr(d.Profile.ID) }
						data-item-id=""
						data-category=""
						data-choice=""
						data-origin=""
						data-note=""
						data-url=""
						data-icon-url=""
					>
						{ p.T("app.add_stack_item") }
					</button>
				</section>
			} else {
				@d.SharePayloadScript()
				<div class="stack-wrap">
					<table class="stack">
						<thead>
							<tr>
								<th class="stack-icon-col"><span class="sr-only">{ p.T("app.icon") }</span></th>
								<th>{ p.T("app.stack_category") }</th>
								<th>{ p.T("app.stack_choice") }</th>
								<th>{ p.T("app.stack_origin") }</th>
								<th>{ p.T("app.stack_note") }</th>
								<th class="stack-edit-col edit-only"><span class="sr-only">{ p.T("js.edit") }</span></th>
							</tr>
						</thead>
						<tbody data-controller="sort" data-sort-url-value={ d.ReorderURL }>
							for _, item := range d.Items {
								<tr draggable="true" data-id={ idStr(item.ID) } data-action="dragstart->sort#start dragover->sort#over drop->sort#drop dragend->sort#end">
									<td class="stack-icon-col">@Mark(item.IconSrc(), item.Letter(), item.Color(), "sm")</td>
									<td data-label={ p.T("app.stack_category") } class="stack-cat">{ item.Category }</td>
									<td data-label={ p.T("app.stack_choice") } class="stack-choice">
										if item.Linked() {
											<a href={ templ.SafeURL(item.URL) } target="_blank" rel="noopener noreferrer">{ item.Choice }</a>
										} else {
											{ item.Choice }
										}
									</td>
									<td data-label={ p.T("app.stack_origin") } class="stack-origin">{ item.Origin }</td>
									<td data-label={ p.T("app.stack_note") } class="stack-note">{ item.Note }</td>
									<td class="stack-edit-col edit-only">
										<div class="row-actions">
											<button
												type="button"
												class="row-edit"
												data-action="dialog#openStack"
												data-heading={ p.T("app.edit_stack_item") }
												data-profile-id={ idStr(d.Profile.ID) }
												data-item-id={ idStr(item.ID) }
												data-category={ item.Category }
												data-choice={ item.Choice }
												data-origin={ item.Origin }
												data-note={ item.Note }
												data-url={ item.URL }
												data-icon-url={ item.IconURL }
												aria-label={ p.T("app.edit_stack_item") }
											>
												<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.4 3.2 12.8 5.6 6.2 12.2H3.8v-2.4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>
											</button>
											<form class="row-delete-form" action={ "/stack_items/" + idStr(item.ID) } method="post" data-controller="confirm" data-action="submit->confirm#ask" data-confirm-message={ p.T("js.delete_stack_confirm") }>
												<input type="hidden" name="csrf_token" value={ p.CSRF }/>
												<input type="hidden" name="_method" value="delete"/>
												<button type="submit" class="row-edit is-danger" aria-label={ p.T("app.delete") }>
													<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 4.3h9M6.2 4.3V3.4h3.6v.9M5.3 6.4v5.2M8 6.4v5.2M10.7 6.4v5.2M4.6 4.3l.55 8.1h5.7l.55-8.1" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
												</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
					<button
						type="button"
						class="stack-add"
						data-action="dialog#openStack"
						data-heading={ p.T("app.add_stack_item") }
						data-profile-id={ idStr(d.Profile.ID) }
						data-item-id=""
						data-category=""
						data-choice=""
						data-origin=""
						data-note=""
						data-url=""
						data-icon-url=""
					>
						{ p.T("app.add_stack_item") }
					</button>
				</div>
			}
		</main>
		<button
			type="button"
			class="fab"
			data-action="dialog#openStack"
			data-heading={ p.T("app.add_stack_item") }
			data-profile-id={ idStr(d.Profile.ID) }
			data-item-id=""
			data-category=""
			data-choice=""
			data-origin=""
			data-note=""
			data-url=""
			data-icon-url=""
			aria-label={ p.T("app.add_stack_item") }
		>
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
		</button>
		@StackDialog(p, d)
		@ProfileDialog(p, d)
	</div>
}

templ Mark(iconSrc string, letter string, color string, size string) {
	<span class={ "mark mark-" + size } style={ "background: " + color }>
		if iconSrc != "" {
			<img src={ iconSrc } alt="" class="mark-favicon" data-controller="favicon" data-action="load->favicon#show error->favicon#hide"/>
		}
		<span class="mark-letter">{ letter }</span>
	</span>
}

templ Header(p Page, d HomeData) {
	<p class="offline-banner" data-offline-target="banner" hidden>{ p.T("app.offline") }</p>
	<header class="home-top">
		@Wordmark()
		<nav class="views" aria-label={ p.T("app.views") }>
			<a href={ "/?profile_id=" + idStr(d.Profile.ID) } class={ viewTabClass(!d.OnStack) }>{ p.T("app.sites_view") }</a>
			<a href={ "/stack?profile_id=" + idStr(d.Profile.ID) } class={ viewTabClass(d.OnStack) }>{ p.T("app.stack_view") }</a>
		</nav>
		@AccountLink(p)
		<button type="button" class="icon-btn" data-action="theme#cycle" data-theme-button title={ p.T("auth.theme") } aria-label={ p.T("auth.theme") }>
			<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.3"></circle><path d="M8 3a5 5 0 0 0 0 10Z" fill="currentColor"></path></svg>
		</button>
		<button type="button" class="icon-btn desktop-only" data-action="lock#lock" title={ p.T("app.lock") } aria-label={ p.T("app.lock") }>
			<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.4" y="7.2" width="9.2" height="6.4" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.3"></rect><path d="M5.3 7.2V5.4a2.7 2.7 0 0 1 5.4 0v1.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
		</button>
		<button type="button" class="icon-btn" data-action="menu#toggle" data-menu-target="menuButton" title={ p.T("app.more") } aria-label={ p.T("app.more") } aria-expanded="false">
			<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="3.5" r="1.1" fill="currentColor"></circle><circle cx="8" cy="8" r="1.1" fill="currentColor"></circle><circle cx="8" cy="12.5" r="1.1" fill="currentColor"></circle></svg>
		</button>
		<div class="mobile-menu" data-menu-target="menu" hidden>
			<button type="button" class="btn-io" data-action="edit#toggle menu#close" aria-pressed="false">
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.4 3.2 12.8 5.6 6.2 12.2H3.8v-2.4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>
				<span data-edit-target="label">{ p.T("js.edit") }</span>
			</button>
			<form action="/lock" method="post">
				<input type="hidden" name="csrf_token" value={ p.CSRF }/>
				<button type="submit" class="btn-io">
					<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.4" y="7.2" width="9.2" height="6.4" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.3"></rect><path d="M5.3 7.2V5.4a2.7 2.7 0 0 1 5.4 0v1.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
					<span>{ p.T("app.lock") }</span>
				</button>
			</form>
			@AutoLockButton(p, d.AutoLock)
			@ChangePasswordButton(p)
			@LanguageSwitch(p)
			@SignOut(p)
		</div>
	</header>
}

templ Profiles(p Page, d HomeData) {
	<nav class="profiles" aria-label={ p.T("app.default_profile") }>
		for _, profile := range d.Profiles {
			<a href={ d.ProfileHref(profile.ID) } class={ profileTabClass(profile.ID == d.Profile.ID) }>{ profile.Name }</a>
		}
		<button
			type="button"
			class="profile-tab profile-add edit-only"
			data-action="dialog#openProfile"
			data-heading={ p.T("app.add_profile") }
			data-profile-id=""
			data-name=""
			title={ p.T("app.add_profile") }
			aria-label={ p.T("app.add_profile") }
		>+</button>
		<button
			type="button"
			class="profile-tab profile-edit edit-only"
			data-action="dialog#openProfile"
			data-heading={ p.T("app.edit_profile") }
			data-profile-id={ idStr(d.Profile.ID) }
			data-name={ d.Profile.Name }
			data-destroyable={ onOff(len(d.Profiles) > 1) }
			title={ p.T("app.edit_profile") }
			aria-label={ p.T("app.edit_profile") }
		>
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.4 3.2 12.8 5.6 6.2 12.2H3.8v-2.4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>
		</button>
	</nav>
}

templ SiteDialog(p Page, d HomeData) {
	<dialog class="confirm-dialog form-dialog" data-dialog-target="siteBox" data-action="click->dialog#backdrop">
		<p class="dialog-heading" data-dialog-target="siteHeading">{ p.T("app.add_site") }</p>
		<form action="/sites" method="post" class="auth-form" data-dialog-target="siteForm">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<input type="hidden" name="_method" value="post" data-dialog-target="siteMethod"/>
			<input type="hidden" name="site[profile_id]" value={ idStr(d.Profile.ID) }/>
			<label>
				{ p.T("app.title") }
				<input type="text" name="site[title]" maxlength="80" autocomplete="off"/>
			</label>
			<label>
				{ p.T("app.url") }
				<input type="text" name="site[url]" maxlength="2048" inputmode="url" autocomplete="off" placeholder={ p.T("app.url_placeholder") }/>
			</label>
			<label>
				{ p.T("app.hint") }
				<input type="text" name="site[hint]" maxlength="120" autocomplete="off" placeholder={ p.T("app.hint_placeholder") }/>
			</label>
			<label>
				{ p.T("app.icon") }
				<input type="text" name="site[icon_url]" maxlength="2048" inputmode="url" autocomplete="off" placeholder={ p.T("app.icon_placeholder") }/>
			</label>
			<div class="confirm-actions">
				<button type="button" class="btn-dialog" data-action="dialog#closeSite">{ p.T("app.cancel") }</button>
				<input type="submit" value={ p.T("app.save") } class="btn-dialog primary"/>
			</div>
		</form>
		<div data-dialog-target="siteDelete" hidden>
			<form action="#" method="post" data-controller="confirm" data-action="submit->confirm#ask" data-confirm-message={ p.T("js.delete_site_confirm") }>
				<input type="hidden" name="csrf_token" value={ p.CSRF }/>
				<input type="hidden" name="_method" value="delete"/>
				<button type="submit" class="btn-dialog danger dialog-delete">{ p.T("app.delete") }</button>
			</form>
		</div>
	</dialog>
}

templ StackDialog(p Page, d HomeData) {
	<dialog class="confirm-dialog form-dialog" data-dialog-target="stackBox" data-action="click->dialog#backdrop">
		<p class="dialog-heading" data-dialog-target="stackHeading">{ p.T("app.add_stack_item") }</p>
		<form action="/stack_items" method="post" class="auth-form" data-dialog-target="stackForm">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<input type="hidden" name="_method" value="post" data-dialog-target="stackMethod"/>
			<input type="hidden" name="stack_item[profile_id]" value={ idStr(d.Profile.ID) }/>
			<label>
				{ p.T("app.stack_category") }
				<input type="text" name="stack_item[category]" maxlength="60" autocomplete="off" placeholder={ p.T("app.stack_category_placeholder") }/>
			</label>
			<label>
				{ p.T("app.stack_choice") }
				<input type="text" name="stack_item[choice]" maxlength="80" autocomplete="off" placeholder={ p.T("app.stack_choice_placeholder") }/>
			</label>
			<label>
				{ p.T("app.stack_origin") }
				<input type="text" name="stack_item[origin]" maxlength="80" autocomplete="off" placeholder={ p.T("app.stack_origin_placeholder") }/>
			</label>
			<label>
				{ p.T("app.stack_note") }
				<input type="text" name="stack_item[note]" maxlength="160" autocomplete="off" placeholder={ p.T("app.stack_note_placeholder") }/>
			</label>
			<label>
				{ p.T("app.url") }
				<input type="text" name="stack_item[url]" maxlength="2048" inputmode="url" autocomplete="off" placeholder={ p.T("app.stack_url_placeholder") }/>
			</label>
			<label>
				{ p.T("app.icon") }
				<input type="text" name="stack_item[icon_url]" maxlength="2048" inputmode="url" autocomplete="off" placeholder={ p.T("app.icon_placeholder") }/>
			</label>
			<div class="confirm-actions">
				<button type="button" class="btn-dialog" data-action="dialog#closeStack">{ p.T("app.cancel") }</button>
				<input type="submit" value={ p.T("app.save") } class="btn-dialog primary"/>
			</div>
		</form>
		<div data-dialog-target="stackDelete" hidden>
			<form action="#" method="post" data-controller="confirm" data-action="submit->confirm#ask" data-confirm-message={ p.T("js.delete_stack_confirm") }>
				<input type="hidden" name="csrf_token" value={ p.CSRF }/>
				<input type="hidden" name="_method" value="delete"/>
				<button type="submit" class="btn-dialog danger dialog-delete">{ p.T("app.delete") }</button>
			</form>
		</div>
	</dialog>
}

templ ProfileDialog(p Page, d HomeData) {
	<dialog class="confirm-dialog form-dialog" data-dialog-target="profileBox" data-action="click->dialog#backdrop">
		<p class="dialog-heading" data-dialog-target="profileHeading">{ p.T("app.add_profile") }</p>
		<form action="/profiles" method="post" class="auth-form" data-dialog-target="profileForm">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<input type="hidden" name="_method" value="post" data-dialog-target="profileMethod"/>
			<label>
				{ p.T("app.profile_name") }
				<input type="text" name="profile[name]" maxlength="40" autocomplete="off" placeholder={ p.T("app.profile_placeholder") }/>
			</label>
			<div class="confirm-actions">
				<button type="button" class="btn-dialog" data-action="dialog#closeProfile">{ p.T("app.cancel") }</button>
				<input type="submit" value={ p.T("app.save") } class="btn-dialog primary"/>
			</div>
		</form>
		<div data-dialog-target="profileDelete" hidden>
			<form action="#" method="post" data-controller="confirm" data-action="submit->confirm#ask" data-confirm-message={ p.T("js.delete_profile_confirm") }>
				<input type="hidden" name="csrf_token" value={ p.CSRF }/>
				<input type="hidden" name="_method" value="delete"/>
				<button type="submit" class="btn-dialog danger dialog-delete">{ p.T("app.delete") }</button>
			</form>
		</div>
	</dialog>
}
