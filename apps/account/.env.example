# Copy to .env and fill in. Then:
#   docker compose up -d --build
# After editing .env, apply with:
#   docker compose up -d
# (compose restart keeps the old env; up -d recreates the container.)

# Public signup form. true for the first account, then flip to false.
SIGNUP_ENABLED=true

# Optional. When both are set:
# - signup creates the account only after the person opens the email
#   link and re-enters the password
# - the login page shows "Forgot password?" (one email, single-use link,
#   valid for 1 hour; the reply does not say whether the email exists)
# Leave both empty for a family self-host: signup stays immediate, the
# forgot-password link is hidden, and passwords are reset from the shell
# (see README). There is no SMTP fallback.
# RESEND_FROM must be a sender verified in Resend (onboarding@resend.dev
# only delivers to the Resend account owner).
#RESEND_API_KEY=
#RESEND_FROM=tansu@gettansu.com

# Set true when your own Caddy/nginx terminates HTTPS in front.
FORCE_SSL=false

# Your public hostname. Comma-separated if you have more than one.
# Leave empty only while testing.
KURA_HOST=account.gettansu.com

# Publish only on localhost so 80/443 stay free for your proxy.
# Point Caddy or nginx at 127.0.0.1:3006.
BIND=127.0.0.1:3006

# Static first-party client registry (JSON). Each suite app that offers
# "Entrar com Tansu" needs an entry with a secret>=16 chars and the exact
# callback URL(s). Secrets live only here (hashed into the DB at boot).
# Example for local dev (People on :3005, Calendar on :3003):
# KURA_CLIENTS_JSON=[{"id":"kurapeople","secret":"change-me-16-chars-min","name":"TansuPeople","home":"https://people.gettansu.com/","icon":"🧑","redirect_uris":["https://people.gettansu.com/login/kura/callback"]},{"id":"kuracalendar","secret":"change-me-16-chars-min","name":"TansuCalendar","home":"https://calendar.gettansu.com/","icon":"📅","redirect_uris":["https://calendar.gettansu.com/login/kura/callback"]}]
KURA_CLIENTS_JSON=
