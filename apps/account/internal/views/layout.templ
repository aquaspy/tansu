package views

// Layout is the application shell: theme bootstrap, meta, assets, i18n blob.
templ Layout(p Page, head templ.Component, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ p.Lang() }>
		<head>
			<script>
				(function () {
					var m = document.cookie.match(/(?:^|; )tansu_theme=([^;]*)/);
					var theme = m ? decodeURIComponent(m[1]) : "";
					if (theme !== "light" && theme !== "dark" && theme !== "system") theme = localStorage.getItem("kura.theme") || "system";
					document.documentElement.dataset.theme = theme;
				})()
			</script>
			<title>{ p.Title }</title>
			<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
			<meta name="application-name" content="TansuAccount"/>
			<meta name="mobile-web-app-capable" content="yes"/>
			<meta name="theme-color" content="#0a0d12"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="csrf-token" content={ p.CSRF }/>
			if head != nil {
				@head
			}
			<link rel="manifest" href="/manifest"/>
			<link rel="icon" href="/icon.svg" type="image/svg+xml"/>
			<link rel="icon" href="/icon.png" type="image/png" sizes="512x512"/>
			<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180"/>
			<link rel="stylesheet" href="/css/app.css"/>
			<script src="/js/vendor/htmx.min.js" defer></script>
			<script src="/js/app.js" defer></script>
			@p.I18nScript()
		</head>
		<body class={ bodyClass(p) } data-controller="theme">
			@content
		</body>
	</html>
}

// NoHead is the empty head addon for regular pages.
func NoHead() templ.Component {
	return nil
}

func bodyClass(p Page) string {
	if p.BodyClass != "" {
		return p.BodyClass
	}
	return "app-body"
}
