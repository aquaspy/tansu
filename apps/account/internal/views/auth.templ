package views

templ LoginPage(p Page, email string, signupOpen bool, mailEnabled bool) {
	<section class="auth-card">
		@Wordmark()
		<h1>{ p.T("auth.sign_in") }</h1>
		<p class="lede">{ p.T("auth.sign_in_lede") }</p>
		if p.Notice != "" {
			<p class="flash flash-notice" role="status">{ p.Notice }</p>
		}
		<form action="/login" method="post" class="auth-form">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			if p.Next != "" {
				<input type="hidden" name="next" value={ p.Next }/>
			}
			if p.Alert != "" {
				<p class="error">{ p.Alert }</p>
			}
			<label>
				{ p.T("auth.email") }
				<input type="email" name="email" value={ email } autocomplete="username" required/>
			</label>
			<label>
				{ p.T("auth.password") }
				<input type="password" name="password" autocomplete="current-password" required minlength="8"/>
			</label>
			<input type="submit" value={ p.T("auth.sign_in") } class="btn-primary"/>
		</form>
		if mailEnabled {
			<p class="auth-foot"><a href={ templ.SafeURL(WithNext("/password/forgot", p.Next)) }>{ p.T("auth.forgot_password") }</a></p>
		}
		if signupOpen {
			<p class="auth-foot">{ p.T("auth.no_account") } <a href={ templ.SafeURL(WithNext("/signup", p.Next)) }>{ p.T("auth.create_one") }</a></p>
		}
		@ThemeSwitch(p)
	</section>
}

templ SignupPage(p Page, email string, mailEnabled bool) {
	<section class="auth-card">
		@Wordmark()
		<h1>{ p.T("auth.create_account") }</h1>
		if mailEnabled {
			<p class="lede">{ p.T("auth.signup_lede_mail") }</p>
		} else {
			<p class="lede">{ p.T("auth.signup_lede") }</p>
		}
		<form action="/signup" method="post" class="auth-form">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			if p.Next != "" {
				<input type="hidden" name="next" value={ p.Next }/>
			}
			if p.Alert != "" {
				<p class="error">{ p.Alert }</p>
			}
			<label>
				{ p.T("auth.email") }
				<input type="email" name="email" value={ email } autocomplete="username" required/>
			</label>
			<label>
				{ p.T("auth.password") }
				<input type="password" name="password" autocomplete="new-password" required minlength="8"/>
			</label>
			<label>
				{ p.T("auth.confirm_password") }
				<input type="password" name="password_confirmation" autocomplete="new-password" required minlength="8"/>
			</label>
			<input type="submit" value={ p.T("auth.create_account") } class="btn-primary"/>
		</form>
		<p class="auth-foot">{ p.T("auth.have_account") } <a href={ templ.SafeURL(WithNext("/login", p.Next)) }>{ p.T("auth.sign_in") }</a></p>
		@ThemeSwitch(p)
	</section>
}

templ SignupSentPage(p Page, email string) {
	<section class="auth-card">
		@Wordmark()
		<h1>{ p.T("auth.signup_sent_title") }</h1>
		<p class="lede">{ p.T("auth.signup_sent_lede", "email", email) }</p>
		<p class="auth-foot"><a href={ templ.SafeURL(WithNext("/login", p.Next)) }>{ p.T("auth.sign_in") }</a></p>
		@ThemeSwitch(p)
	</section>
}

templ SignupConfirmPage(p Page, token string) {
	<section class="auth-card">
		@Wordmark()
		<h1>{ p.T("auth.signup_confirm_title") }</h1>
		<p class="lede">{ p.T("auth.signup_confirm_lede") }</p>
		<form action="/signup/confirm" method="post" class="auth-form">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<input type="hidden" name="token" value={ token }/>
			if p.Alert != "" {
				<p class="error">{ p.Alert }</p>
			}
			<label>
				{ p.T("auth.password") }
				<input type="password" name="password" autocomplete="current-password" required minlength="8" autofocus/>
			</label>
			<input type="submit" value={ p.T("auth.signup_confirm_submit") } class="btn-primary"/>
		</form>
		@ThemeSwitch(p)
	</section>
}

