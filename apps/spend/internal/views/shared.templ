package views

templ Wordmark() {
	<p class="wordmark">
		<img src="/icon.png" width="28" height="28" alt="" decoding="async"/>
		<span>TansuSpend</span>
	</p>
}

templ ThemeSwitch(p Page) {
	<div class="theme-switch" role="group" aria-label={ p.T("auth.theme") }>
		<button
			type="button"
			class="theme-choice"
			data-action="theme#set"
			data-theme-choice="light"
			title={ p.T("js.theme_light") }
			aria-label={ p.T("js.theme_light") }
		>
			<svg viewBox="0 0 16 16" aria-hidden="true">
				<circle cx="8" cy="8" r="2.4" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
				<path d="M8 1.6v1.5M8 12.9v1.5M1.6 8h1.5M12.9 8h1.5M3.3 3.3l1.1 1.1M11.6 11.6l1.1 1.1M3.3 12.7l1.1-1.1M11.6 4.4l1.1-1.1" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
			</svg>
		</button>
		<button
			type="button"
			class="theme-choice"
			data-action="theme#set"
			data-theme-choice="system"
			title={ p.T("js.theme_system") }
			aria-label={ p.T("js.theme_system") }
		>
			<svg viewBox="0 0 16 16" aria-hidden="true">
				<circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
				<path d="M8 3a5 5 0 0 0 0 10Z" fill="currentColor"></path>
			</svg>
		</button>
		<button
			type="button"
			class="theme-choice"
			data-action="theme#set"
			data-theme-choice="dark"
			title={ p.T("js.theme_dark") }
			aria-label={ p.T("js.theme_dark") }
		>
			<svg viewBox="0 0 16 16" aria-hidden="true">
				<path d="M10.2 2.4A5.4 5.4 0 1 0 13.6 11 4.4 4.4 0 0 1 10.2 2.4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
			</svg>
		</button>
	</div>
}

// SignOut posts DELETE /logout via htmx; app.js wipes the offline cache
// on response and navigates to /login.
templ SignOut(p Page) {
	<form
		action="/logout"
		method="post"
		hx-delete="/logout"
		hx-swap="none"
		data-controller="logout"
	>
		<input type="hidden" name="csrf_token" value={ p.CSRF }/>
		<button type="submit" class="btn-io">
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.2 3.2H4.4A1.4 1.4 0 0 0 3 4.6v6.8A1.4 1.4 0 0 0 4.4 12.8h1.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path><path d="M6.8 8h6.2M10.4 5.4 13 8l-2.6 2.6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			<span>{ p.T("app.sign_out") }</span>
		</button>
	</form>
}

templ AutoLockButton(p Page, enabled bool) {
	<button type="button" class="btn-io" data-action="lock#togglePreference">
		<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.2" fill="none" stroke="currentColor" stroke-width="1.3"></circle><path d="M8 5.2v3.1l2.1 1.3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		<span data-auto-lock-label>
			if enabled {
				{ p.T("app.auto_lock_off") }
			} else {
				{ p.T("app.auto_lock_on") }
			}
		</span>
	</button>
}

templ ChangePasswordButton(p Page) {
	<a href="/password/edit" class="btn-io">
		<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="5.4" cy="8" r="2.5" fill="none" stroke="currentColor" stroke-width="1.3"></circle><path d="M7.8 8h5.4v2.1M11.2 8v1.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		<span>{ p.T("auth.change_password") }</span>
	</a>
}

templ APITokensButton(p Page) {
	<a href="/api_tokens/" class="btn-io">
		<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="5.6" cy="8" r="2.4" fill="none" stroke="currentColor" stroke-width="1.3"></circle><path d="M8 8h5.2M11.4 8v1.9M13.2 8v1.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
		<span>{ p.T("tokens.title") }</span>
	</a>
}

templ TransferButtons(p Page, d SpendData) {
	<div class="io-actions">
		<a href="/export" class="btn-io">
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v8M5 8.2 8 11.2 11 8.2M3 13.2h10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			<span>{ p.T("app.export") }</span>
		</a>
		<form action="/import" method="post" enctype="multipart/form-data" class="import-form">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<label class="btn-io">
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13.2V5.2M5 8.2 8 5.2 11 8.2M3 2.8h10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				<span>{ p.T("app.import") }</span>
				<input type="file" name="file" accept=".json,application/json" class="sr-only" onchange="this.form.requestSubmit()"/>
			</label>
		</form>
	</div>
}
