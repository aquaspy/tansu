# Copy to .env and fill in. Then:
#   docker compose up -d --build
# After editing .env, apply with:
#   docker compose up -d
# (compose restart keeps the old env; up -d recreates the container.)

# Public signup form. true for the first account, then flip to false.
SIGNUP_ENABLED=true

# Set true when your own Caddy/nginx terminates HTTPS in front.
FORCE_SSL=false

# Your public hostname. Comma-separated if you have more than one.
# Leave empty only while testing. Share links use the request host.
KURA_HOST=assistant.gettansu.com

# Publish only on localhost so 80/443 stay free for your proxy.
# Point Caddy or nginx at 127.0.0.1:3000. No WebSocket upgrade needed
# (live replies stream over plain SSE).
BIND=127.0.0.1:3000

# OpenRouter — required for replies. Keys stay on the server.
# From https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Any model slug. Date-pinned slugs (openai/gpt-6-luna-20260922) also work.
OPENROUTER_MODEL=openai/gpt-6-luna
# Comma-separated slugs for the per-chat model picker. First is the default.
# Unset: OPENROUTER_MODEL alone when set (picker hidden), else the 5-model
# deploy menu (luna, deepseek-v4.1-flash, claude-opus-5.5, muse-glimmer-30b,
# grok-4.7).
# OPENROUTER_MODELS=openai/gpt-6-luna,x-ai/grok-4.7,deepseek/deepseek-v3.2
# Picker price-tier dots (blended $/1M): <= cheap max is green, >= expensive
# min is red, between is amber. Pins force a tier: "id:tier,...".
OPENROUTER_TIER_CHEAP_MAX=1
OPENROUTER_TIER_EXPENSIVE_MIN=10
# OPENROUTER_TIER_PINS=x-ai/grok-4.7:expensive
# Default thinking effort (none|low|medium|high|xhigh|max, model permitting).
# Reasoning tokens bill as output. Titles and compaction always use none
# (and the default model, never search).
OPENROUTER_REASONING_EFFORT=xhigh
# Per-chat model and effort pickers. false (default) hides both and every
# turn uses OPENROUTER_MODEL / OPENROUTER_MODELS first entry plus
# OPENROUTER_REASONING_EFFORT. Set true for a self-hosted picker.
# ASSISTANT_SHOW_MODEL_CONTROLS=false

# PDF parsing engine for attached documents (OpenRouter file-parser
# plugin): mistral-ocr (default, best for scans, $2/1k pages),
# cloudflare-ai (free), native (models with file input, billed as tokens).
OPENROUTER_PDF_ENGINE=mistral-ocr

# Word/PowerPoint uploads convert to PDF locally before entering the same
# pipeline. Needs a headless LibreOffice (the Docker image ships one);
# override the binary lookup when it lives elsewhere.
# LIBREOFFICE_BIN=/usr/bin/soffice

# Every request enforces Zero Data Retention provider routing (provider.zdr),
# on top of whatever ZDR you set on the OpenRouter account.

# Voice mode (mic dictate + spoken replies), all billed per use on the same
# OpenRouter key. STT model for transcriptions, TTS model + voice ids for
# speech (Azure neural names). Replies are read in the voice matching
# their detected language (English voice below, default voice otherwise).
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_TTS_MODEL=microsoft/mai-voice-2
OPENROUTER_TTS_VOICE=pt-BR-FranciscaNeural
OPENROUTER_TTS_VOICE_EN=en-US-AvaNeural

# Web search — explicit per-turn toggle, off unless the globe is on.
# Runs through OpenRouter's web plugin (one search per searched turn).
# SEARCH_ENABLED=false hides the toggle and forces every turn searchless.
# SEARCH_ENABLED=true
# Engine pinned to exa so results don't change when you switch models.
# Alternatives: native (provider passthrough pricing), parallel, perplexity, firecrawl (BYOK).
# SEARCH_ENGINE=exa
# Exa mode: auto (keyword+neural hybrid, ~1s) is the quality default;
# fast (~450ms) at the same $0.007/request; deep-lite/deep ($0.012) for harder queries.
# SEARCH_MODE=auto
# Results per search (1-25, default 5; past 10 adds $0.001/result).
# SEARCH_MAX_RESULTS=5
# Deep toggle: mode + results for research questions (deep-lite ~4s, $0.012).
# SEARCH_DEEP_MODE=deep-lite
# SEARCH_DEEP_MAX_RESULTS=10
# The plugin fee is folded into usage.cost, so the pill already includes it
# (each searched turn itemizes search_engine/search_cost_usd in its usage).
# Set false only if your Activity page shows the fee billed separately.
# SEARCH_FEE_INCLUDED=true

# How much history the model sees. Compact keeps this much recent raw text.
# CHAT_WINDOW_TOKENS=150000           # Stay under the 272k price step
# CHAT_KEEP_RECENT_TOKENS=32000
# CHAT_REPLY_MAX_TOKENS=              # Optional hard cap. Unset = no cap (anti-loop is server-side).

# Tansu Account SSO (optional). Set all three to offer "Entrar com Tansu"
# next to the standalone password login; leave unset for standalone-only.
# Register this app's redirect URI (KURA_HOST + /login/kura/callback)
# in the account's KURA_CLIENTS_JSON with the same client id + secret.
#KURA_ACCOUNT_URL=https://account.gettansu.com
#KURA_CLIENT_ID=kurachat
#KURA_CLIENT_SECRET=change-me-to-16plus-chars

# Sibling apps the chat can act on. Empty hides that app.
# Each sibling also needs KURA_ASSISTANT_URL set to this app's origin
# (local fleet: http://127.0.0.1:3201, production: https://assistant.gettansu.com).
#KURA_NOTES_URL=https://notes.gettansu.com
#KURA_CALENDAR_URL=https://calendar.gettansu.com
#KURA_SPEND_URL=https://spend.gettansu.com
#KURA_PEOPLE_URL=https://people.gettansu.com
#KURA_EMAIL_URL=https://email.gettansu.com
# 32-byte hex key. Required to link. openssl rand -hex 32
# A copied database without this key does not reveal the tokens.
#KURA_APPS_KEY=
# IANA zone for "today" in the prompt. Empty keeps America/Sao_Paulo.
#KURA_TIMEZONE=America/Sao_Paulo
# Optional model for turns that call apps, when it is one of OPENROUTER_MODELS.
# Empty uses the conversation's model.
#KURA_TOOL_MODEL=
