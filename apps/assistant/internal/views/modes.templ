package views

import "fmt"

// ChatChrome is the thread header: personality picker and the Anônimo toggle.
// showBack is the mobile return control when the title bar is hidden.
templ ChatChrome(p Page, personality string, anonymous bool, draftID int64, empty, showBack bool, back string) {
	<div class="chat-header">
		if showBack {
			<a href={ templ.SafeURL(back) } class="icon-btn back" aria-label={ p.T("app.cancel") }>
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.2 3.2 5.4 8l4.8 4.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</a>
		}
		@PersonalityPicker(p, personality, anonymous, draftID, empty)
		<span class="bar-spacer"></span>
		@AnonToggle(p, anonymous)
	</div>
	if anonymous {
		<p class="anon-banner" role="status">
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.8 13.2 4v4.2c0 3-2.1 4.7-5.2 6-3.1-1.3-5.2-3-5.2-6V4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path><path d="M5.6 8.1 7.2 9.7 10.5 6.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			<span>{ p.T("mode.not_saved_banner") }</span>
		</p>
	}
}

// PersonalityPicker is Assistente or Conversa. Anônimo is not a choice here.
templ PersonalityPicker(p Page, current string, anonymous bool, draftID int64, empty bool) {
	<details class="mode-menu personality-menu" data-controller="disclosure">
		<summary class={ "personality-pill is-" + current } aria-haspopup="menu" aria-label={ p.T("mode.label") }>
			<span class="personality-label">{ p.T("mode." + current) }</span>
			<svg class="personality-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 6.5 8 10l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		</summary>
		<div class="mode-panel">
			<div class="mode-switch is-list" role="menu" aria-label={ p.T("mode.label") }>
				@personalityChoice(p, "assistant", current, anonymous, draftID, empty)
				@personalityChoice(p, "chat", current, anonymous, draftID, empty)
			</div>
		</div>
	</details>
}

templ personalityChoice(p Page, mode, current string, anonymous bool, draftID int64, empty bool) {
	if mode == current {
		<button type="button" class="mode-option is-on" role="menuitem" aria-current="true" title={ modeTip(p, mode) }>
			<span>{ p.T("mode." + mode) }</span>
			@modeCheck()
		</button>
	} else {
		<form action="/conversations/" method="post" class="mode-form">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<input type="hidden" name="mode" value={ mode }/>
			if anonymous {
				<input type="hidden" name="anon" value="1"/>
			} else if empty && draftID > 0 {
				<input type="hidden" name="draft_id" value={ fmt.Sprint(draftID) }/>
			}
			<button type="submit" class="mode-option" role="menuitem" title={ modeTip(p, mode) }>
				<span>{ p.T("mode." + mode) }</span>
			</button>
		</form>
	}
}

// AnonToggle turns persistence off (anonymous) or back on. It is not a personality.
templ AnonToggle(p Page, on bool) {
	if on {
		<form action="/conversations/" method="post" class="anon-toggle-form">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<button type="submit" class="anon-pill is-on" aria-pressed="true" title={ p.T("mode.anonymous_tip") }>
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.8 13.2 4v4.2c0 3-2.1 4.7-5.2 6-3.1-1.3-5.2-3-5.2-6V4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path><path d="M5.6 8.1 7.2 9.7 10.5 6.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				<span>{ p.T("mode.anonymous_on") }</span>
			</button>
		</form>
	} else {
		<a class="anon-toggle" href="/anonymous" aria-pressed="false" title={ p.T("mode.anonymous_tip") }>
			<span class="anon-switch" aria-hidden="true"></span>
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.8 13.2 4v4.2c0 3-2.1 4.7-5.2 6-3.1-1.3-5.2-3-5.2-6V4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>
			<span class="anon-toggle-label">{ p.T("mode.anonymous") }</span>
		</a>
	}
}

templ modeCheck() {
	<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
}

// ModeHero is the quiet empty thread: a greeting or short hint, no suggestion cards.
templ ModeHero(p Page, mode string, collapsed bool) {
	<div class="mode-hero" data-anon-target="hero" hidden?={ collapsed }>
		<svg class="mode-hero-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 4.5c.4 4.2 1.6 7.2 4.2 9.2-2.8.6-5 2.2-6.4 5.3-.4-3.6-2-6.2-5.4-7.8 3.2-1.8 5.4-4.2 6.2-6.7.3 0 .8 0 1.4 0Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path><path d="M8 24.5h16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
		<h1 class="mode-hero-title">{ heroTitle(p, mode) }</h1>
		if heroLede(p, mode) != "" {
			<p class="mode-hero-lede">{ heroLede(p, mode) }</p>
		}
	</div>
}

templ PersistStatus(p Page, anonymous bool) {
	<p class="persist-status">
		if anonymous {
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.8 13.2 4v4.2c0 3-2.1 4.7-5.2 6-3.1-1.3-5.2-3-5.2-6V4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>
			<span>{ p.T("mode.anon_status") }</span>
		} else {
			<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.4" y="7.2" width="9.2" height="6.4" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.3"></rect><path d="M5.3 7.2V5.4a2.7 2.7 0 0 1 5.4 0v1.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
			<span>{ p.T("mode.saved_status") }</span>
		}
	</p>
}

func modeTip(p Page, mode string) string {
	return p.T("mode." + mode + "_tip")
}

templ AppStatus(p Page, badges []AppBadge) {
	if AppStatusKind(badges) == "ok" {
		<span class="app-status is-ok" title={ appStatusTitle(p, badges) } aria-label={ appStatusLabel(p, badges) }>
			<span class="app-status-dot" aria-hidden="true"></span>
			<span class="app-status-text">{ appStatusLabel(p, badges) }</span>
		</span>
	} else {
		<a href="/apps" class={ "app-status is-" + AppStatusKind(badges) } title={ appStatusTitle(p, badges) } aria-label={ appStatusLabel(p, badges) }>
			<span class="app-status-dot" aria-hidden="true"></span>
			<span class="app-status-text">{ appStatusLabel(p, badges) }</span>
		</a>
	}
}

templ exampleCard(label, item string) {
	<button type="button" class="example-chip example-card" data-action="examples#fill" data-examples-text-param={ item }>
		if label != "" {
			<span class="example-app">{ label }</span>
		}
		<span class="example-text">{ item }</span>
	</button>
}

templ ExampleSheet(p Page) {
	<dialog class="confirm-dialog examples-dialog" data-examples-target="dialog" data-action="click->examples#backdrop" aria-labelledby="examples-heading">
		<p class="share-heading" id="examples-heading">{ p.T("chat.what_can_i_do") }</p>
		<p class="examples-hint">{ p.T("chat.examples_hint") }</p>
		<div class="examples examples-list">
			for _, g := range ExampleGroups(p.L) {
				<section class="example-group">
					<p class="example-app">{ g.Label }</p>
					for _, item := range g.Items {
						@exampleCard("", item)
					}
				</section>
			}
		</div>
		<form method="dialog" class="confirm-actions">
			<button type="submit" class="btn-dialog">{ p.T("app.close") }</button>
		</form>
	</dialog>
}

templ AnonClearToggle(p Page) {
	<label class="voice-option anon-close" title={ p.T("mode.clear_on_close_tip") }>
		<input type="checkbox" data-anon-target="close" data-action="change->anon#close"/>
		<span class="voice-pill">
			<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.2" fill="none" stroke="currentColor" stroke-width="1.3"></circle><path d="M8 5.2v3.1l2.1 1.3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			<span>{ p.T("mode.clear_on_close") }</span>
		</span>
	</label>
}

templ ModelField(p Page, id string, models []string, current string, tiers map[string]string, prices map[string]string) {
	if len(models) >= 2 {
		<div class="setting">
			<span id={ "model-label-" + id }>{ p.T("chat.model") }</span>
			<div class="model-picker" data-controller="modelmenu">
				<input type="hidden" name="model" value={ current } data-modelmenu-target="value"/>
				<button
					type="button"
					class="model-menu-btn"
					data-action="click->modelmenu#toggle keydown->modelmenu#key"
					data-modelmenu-target="button"
					aria-haspopup="listbox"
					aria-expanded="false"
					aria-labelledby={ "model-label-" + id }
					title={ tierTitle(p, tiers, prices, current) }
				>
					if tier, ok := tiers[current]; ok {
						<span class={ "tier-dot tier-" + tier } data-modelmenu-target="tier" aria-hidden="true"></span>
					} else {
						<span class="tier-dot" data-modelmenu-target="tier" aria-hidden="true" hidden></span>
					}
					<span class="model-menu-label" data-modelmenu-target="label">{ ModelShort(current) }</span>
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 6.5 8 10l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</button>
				<div class="model-menu" role="listbox" aria-labelledby={ "model-label-" + id } data-modelmenu-target="menu" hidden>
					for _, m := range models {
						<button
							type="button"
							role="option"
							aria-selected={ AriaBool(m == current) }
							class="model-option"
							data-action="click->modelmenu#choose"
							data-modelmenu-value-param={ m }
							data-modelmenu-short-param={ ModelShort(m) }
							data-modelmenu-tier-param={ tiers[m] }
							data-modelmenu-title-param={ tierTitle(p, tiers, prices, m) }
							title={ tierTitle(p, tiers, prices, m) }
						>
							if tier, ok := tiers[m]; ok {
								<span class={ "tier-dot tier-" + tier } aria-hidden="true"></span>
							}
							<span class="model-option-name">{ m }</span>
							<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
						</button>
					}
				</div>
			</div>
		</div>
	}
}

templ EffortField(p Page, id string, efforts []string, current string) {
	<div class="setting">
		<span id={ "effort-label-" + id }>{ p.T("chat.effort") }</span>
		<div class="effort-picker" role="radiogroup" data-controller="effort" aria-labelledby={ "effort-label-" + id }>
			for _, e := range efforts {
				<label class="effort-option" title={ e }>
					<input type="radio" name="effort" value={ e } checked?={ e == current }/>
					<span>{ e }</span>
				</label>
			}
		</div>
	</div>
}

func tierTitle(p Page, tiers, prices map[string]string, slug string) string {
	return ModelTitle(p, &ConversationDetail{ModelTiers: tiers, ModelPrices: prices}, slug)
}

// AnonThread is the browser-held chat. The server does not list it.
templ AnonThread(p Page, d ShellData) {
	<div
		class="anon"
		data-controller="anon"
		data-anon-failed-value={ p.T("js.anon_failed") }
		data-anon-untitled-value={ p.T("chat.untitled") }
		data-anon-thinking-value={ p.T("chat.thinking") }
	>
		@ChatChrome(p, personalityOf(d), true, 0, d.Anon == nil || len(d.Anon.Messages) == 0, true, "/conversations/")
		<div class="editor-bar" data-anon-target="bar" hidden?={ d.Anon == nil || len(d.Anon.Messages) == 0 }>
			<input
				type="text"
				class="folder-input"
				placeholder={ p.T("chat.untitled") }
				autocomplete="off"
				aria-label={ p.T("chat.rename") }
				data-anon-target="title"
				data-action="input->anon#title"
			/>
			<span class="bar-spacer"></span>
			<details class="mode-menu anon-history" data-controller="disclosure" data-anon-target="history" hidden>
				<summary class="icon-btn" title={ p.T("mode.local_menu") } aria-label={ p.T("mode.local_menu") }>
					<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.2" fill="none" stroke="currentColor" stroke-width="1.3"></circle><path d="M8 5.2v3.1l2.1 1.3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</summary>
				<div class="mode-panel">
					<p class="mode-panel-label">{ p.T("mode.local_menu") }</p>
					<div class="anon-local" data-anon-target="local"></div>
					<div class="mode-panel-foot">
						@AnonClearToggle(p)
					</div>
				</div>
			</details>
			<button type="button" class="icon-btn danger" data-action="anon#clear" title={ p.T("mode.clear") } aria-label={ p.T("mode.clear") }>
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 5h9M6.2 5V3.8A1.2 1.2 0 0 1 7.4 2.6h1.2A1.2 1.2 0 0 1 9.8 3.8V5m-5.1 0 .5 7.2A1.3 1.3 0 0 0 6.5 13.4h3a1.3 1.3 0 0 0 1.3-1.2L11.3 5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
			</button>
		</div>
		<div class={ transcriptClass(d.Anon == nil || len(d.Anon.Messages) == 0) } id="anon-transcript" data-anon-target="transcript">
			@ModeHero(p, "anonymous", d.Anon != nil && len(d.Anon.Messages) > 0)
			if d.Anon != nil {
				for _, m := range d.Anon.Messages {
					@AnonArticle(m)
				}
			}
		</div>
		<div class="composer-dock">
			if d.Anon != nil {
				@AnonComposer(p, d.Anon)
			}
		</div>
		<div class="persist-foot">
			@PersistStatus(p, true)
			@AnonClearToggle(p)
		</div>
		if d.Anon != nil && len(d.Anon.Messages) > 0 {
			<script type="application/json" id="anon-seed">
				@templ.Raw(AnonSeed(d.Anon.Messages))
			</script>
		}
	</div>
}

templ AnonArticle(m AnonMessage) {
	<article class={ "msg msg-" + m.Role + " is-done" }>
		if m.Role == "user" {
			<div class="msg-body">
				@templ.Raw(simpleFormat(m.Content))
			</div>
		} else {
			<div class="msg-body">
				@templ.Raw(m.HTML)
			</div>
		}
	</article>
}

templ AnonComposer(p Page, a *AnonPage) {
	<form
		action="/anonymous/complete"
		method="post"
		class="composer"
		data-controller="composer"
		data-action="submit->anon#send keydown->composer#key"
		data-composer-streaming-value="false"
		data-composer-max-images-value="0"
		data-composer-remove-label-value={ p.T("app.cancel") }
	>
		<input type="hidden" name="csrf_token" value={ p.CSRF }/>
		<div class="composer-main">
			<textarea
				name="content"
				rows="1"
				maxlength="16384"
				placeholder={ p.T("chat.placeholder_anon") }
				autofocus?={ len(a.Messages) == 0 }
				enterkeyhint="send"
				data-composer-target="input"
				data-anon-target="input"
				data-action="input->composer#resize input->composer#sync"
			></textarea>
		</div>
		<div class="composer-bar">
		if a.ShowControls {
			<details class="overflow-menu composer-more" data-controller="disclosure">
				<summary class="composer-more-btn">{ p.T("chat.options") }</summary>
				<div class="overflow-panel composer-more-panel">
					<div class="chat-settings anon-controls">
						@ModelField(p, "anon", a.Models, a.CurrentModel, a.ModelTiers, a.ModelPrices)
						@EffortField(p, "anon", a.Efforts, a.CurrentEffort)
					</div>
				</div>
			</details>
		}
		if a.SearchAvail {
			<div class="search-picker" role="group" aria-label={ p.T("chat.web_search") + ", " + p.T("chat.deep_search") }>
				<label class="search-option" title={ p.T("chat.web_search") }>
					<input type="checkbox" name="web" value="1" data-anon-target="web" checked?={ a.SearchOn }/>
					<span class="search-pill">
						<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.4" fill="none" stroke="currentColor" stroke-width="1.3"></circle><path d="M2.6 8h10.8M8 2.6c-3.6 3.5-3.6 7.3 0 10.8M8 2.6c3.6 3.5 3.6 7.3 0 10.8" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg>
						<span>{ p.T("chat.web") }</span>
					</span>
				</label>
				<label class="search-option" title={ p.T("chat.deep_search") }>
					<input type="checkbox" name="deep" value="1" data-anon-target="deep" checked?={ a.DeepOn }/>
					<span class="search-pill">
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.4 13.6 5.4 8 8.4 2.4 5.4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path><path d="M2.4 8.4 8 11.4l5.6-3M2.4 10.9 8 13.9l5.6-3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
						<span>{ p.T("chat.deep") }</span>
					</span>
				</label>
			</div>
		}
		<button type="submit" class="btn-primary" data-composer-target="submit" data-anon-target="submit">{ p.T("chat.send") }</button>
		</div>
	</form>
}

