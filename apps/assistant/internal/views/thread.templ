package views

import "fmt"

// Thread renders the editor column: bar, transcript, composer.
templ Thread(p Page, d ShellData) {
	if d.Current == nil {
		<p class="empty-editor">{ p.T("chat.empty") }</p>
	} else {
		<div
			class="editor-bar"
			data-controller="confirm share"
			data-share-copied-value={ p.T("js.copied") }
		>
			<a href={ templ.SafeURL(backHref(d.Query)) } class="icon-btn back" aria-label={ p.T("app.cancel") }>
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.2 3.2 5.4 8l4.8 4.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</a>
			<form
				action={ templ.SafeURL(fmt.Sprintf("/conversations/%d", d.Current.Conv.ID)) }
				method="post"
				class="title-form"
				data-controller="title"
				data-action="submit->title#sync"
				hx-patch={ fmt.Sprintf("/conversations/%d", d.Current.Conv.ID) }
				hx-target="#conversation-list"
				hx-swap="outerHTML"
			>
				<input type="hidden" name="csrf_token" value={ p.CSRF }/>
				@TitleField(p, d.Current.Conv.ID, d.Current.Conv.Title)
			</form>
			<span class="bar-spacer"></span>
			@ChatCost(p, d.Current.Conv.ID, d.Current.Cost)
			@ShareButton(p, d.Current.Conv.ID, d.Current.Conv.ShareToken != "")
			<button
				type="button"
				class="icon-btn danger"
				data-action="confirm#open"
				data-url={ fmt.Sprintf("/conversations/%d", d.Current.Conv.ID) }
				data-message={ p.T("chat.delete_confirm") }
				title={ p.T("app.delete") }
				aria-label={ p.T("app.delete") }
			>
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 5h9M6.2 5V3.8A1.2 1.2 0 0 1 7.4 2.6h1.2A1.2 1.2 0 0 1 9.8 3.8V5m-5.1 0 .5 7.2A1.3 1.3 0 0 0 6.5 13.4h3a1.3 1.3 0 0 0 1.3-1.2L11.3 5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
			</button>
			<dialog class="confirm-dialog" data-confirm-target="box" data-action="click->confirm#backdrop">
				<p data-confirm-target="message">{ p.T("chat.delete_confirm") }</p>
				<div class="confirm-actions">
					<button type="button" class="btn-dialog" data-action="confirm#close">{ p.T("app.cancel") }</button>
					<button type="button" class="btn-dialog danger" data-confirm-target="destroy">{ p.T("app.delete") }</button>
				</div>
			</dialog>
			<dialog class="confirm-dialog share-dialog" data-share-target="box" data-action="click->share#backdrop">
				<p class="share-heading">{ p.T("app.share") }</p>
				@SharePanel(p, d.Current.Conv.ID, d.Current.Conv.ShareToken != "", d.Current.ShareURL, d.Query)
			</dialog>
		</div>
		<div class="transcript" id="transcript" data-controller="transcript">
			for _, m := range d.Current.Messages {
				@MessageArticle(p, m, d.Current.Conv.ID, d.Current.Inflight)
			}
		</div>
		<div class="composer-dock">
			<div class="chat-settings">
				<form
					action={ templ.SafeURL(fmt.Sprintf("/conversations/%d/settings", d.Current.Conv.ID)) }
					method="post"
					class="settings-form"
					hx-patch={ fmt.Sprintf("/conversations/%d/settings", d.Current.Conv.ID) }
					hx-trigger="change"
					hx-swap="none"
				>
					<input type="hidden" name="csrf_token" value={ p.CSRF }/>
					if len(d.Current.Models) >= 2 {
						<div class="setting">
							<span id={ fmt.Sprintf("model-label-%d", d.Current.Conv.ID) }>{ p.T("chat.model") }</span>
							<div class="model-picker" data-controller="modelmenu">
								<input
									type="hidden"
									name="model"
									value={ d.Current.CurrentModel }
									data-modelmenu-target="value"
								/>
								<button
									type="button"
									class="model-menu-btn"
									data-action="click->modelmenu#toggle keydown->modelmenu#key"
									data-modelmenu-target="button"
									aria-haspopup="listbox"
									aria-expanded="false"
									aria-labelledby={ fmt.Sprintf("model-label-%d", d.Current.Conv.ID) }
									title={ ModelTitle(p, d.Current, d.Current.CurrentModel) }
								>
									if tier, ok := d.Current.ModelTiers[d.Current.CurrentModel]; ok {
										<span class={ "tier-dot tier-" + tier } data-modelmenu-target="tier" aria-hidden="true"></span>
									} else {
										<span class="tier-dot" data-modelmenu-target="tier" aria-hidden="true" hidden></span>
									}
									<span class="model-menu-label" data-modelmenu-target="label">{ ModelShort(d.Current.CurrentModel) }</span>
									<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 6.5 8 10l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
								</button>
								<div
									class="model-menu"
									role="listbox"
									aria-labelledby={ fmt.Sprintf("model-label-%d", d.Current.Conv.ID) }
									data-modelmenu-target="menu"
									hidden
								>
									for _, m := range d.Current.Models {
										<button
											type="button"
											role="option"
											aria-selected={ AriaBool(m == d.Current.CurrentModel) }
											class="model-option"
											data-action="click->modelmenu#choose"
											data-modelmenu-value-param={ m }
											data-modelmenu-short-param={ ModelShort(m) }
											data-modelmenu-tier-param={ d.Current.ModelTiers[m] }
											data-modelmenu-title-param={ ModelTitle(p, d.Current, m) }
											title={ ModelTitle(p, d.Current, m) }
										>
											if tier, ok := d.Current.ModelTiers[m]; ok {
												<span class={ "tier-dot tier-" + tier } aria-hidden="true"></span>
											}
											<span class="model-option-name">{ m }</span>
											<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
										</button>
									}
								</div>
							</div>
						</div>
					}
					<div class="setting">
						<span id={ fmt.Sprintf("effort-label-%d", d.Current.Conv.ID) }>{ p.T("chat.effort") }</span>
						<div
							class="effort-picker"
							role="radiogroup"
							data-controller="effort"
							aria-labelledby={ fmt.Sprintf("effort-label-%d", d.Current.Conv.ID) }
						>
							for _, e := range d.Current.Efforts {
								<label class="effort-option" title={ e }>
									<input
										type="radio"
										name="effort"
										value={ e }
										checked?={ e == d.Current.CurrentEffort }
									/>
									<span>{ e }</span>
								</label>
							}
						</div>
					</div>
					<div class="setting">
						<span id={ fmt.Sprintf("voice-label-%d", d.Current.Conv.ID) }>{ p.T("chat.voice") }</span>
						<div
							class="voice-pills voice-setting"
							role="group"
							aria-labelledby={ fmt.Sprintf("voice-label-%d", d.Current.Conv.ID) }
						>
							<label class="voice-option" title={ p.T("chat.voice_read_tip") }>
								<input
									type="checkbox"
									name="voice_read_aloud"
									value="1"
									checked?={ d.Current.Conv.VoiceReadAloud }
								/>
								<span class="voice-pill">
									<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.6 6v4h2.6L9.4 13V3L5.2 6Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path><path d="M11.4 6.2a3 3 0 0 1 0 3.6M13 4.6a5.4 5.4 0 0 1 0 6.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
									<span>{ p.T("chat.voice_read") }</span>
								</span>
								<input type="hidden" name="voice_read_aloud" value="0"/>
							</label>
							<label class="voice-option" title={ p.T("chat.voice_send_tip") }>
								<input
									type="checkbox"
									name="voice_auto_send"
									value="1"
									checked?={ d.Current.Conv.VoiceAutoSend }
								/>
								<span class="voice-pill">
									<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="6" y="1.6" width="4" height="7.2" rx="2" fill="none" stroke="currentColor" stroke-width="1.3"></rect><path d="M3.8 7.4a4.2 4.2 0 0 0 8.4 0M8 11.6v2.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
									<span>{ p.T("chat.voice_send") }</span>
								</span>
								<input type="hidden" name="voice_auto_send" value="0"/>
							</label>
						</div>
					</div>
				</form>
			</div>
			@Composer(p, d)
		</div>
	}
}

func backHref(q string) string {
	if q != "" {
		return "/conversations/?q=" + urlQueryEscape(q)
	}
	return "/conversations/"
}

// Composer is the message form; htmx appends the echoed pair to #transcript.
templ Composer(p Page, d ShellData) {
	<form
		action={ templ.SafeURL(fmt.Sprintf("/conversations/%d/messages", d.Current.Conv.ID)) }
		method="post"
		enctype="multipart/form-data"
		class="composer"
		data-controller="composer voice"
		data-action="keydown->composer#key paste->composer#paste change->composer#searchToggle"
		data-composer-streaming-value={ fmt.Sprint(d.Current.Inflight) }
		data-composer-max-images-value="4"
		data-composer-remove-label-value={ p.T("app.cancel") }
		data-voice-transcribe-value={ fmt.Sprintf("/conversations/%d/voice/transcribe", d.Current.Conv.ID) }
		data-voice-polish-value={ fmt.Sprintf("/conversations/%d/voice/polish", d.Current.Conv.ID) }
		data-voice-autospeak-value={ BoolFlag(d.Current.Conv.VoiceReadAloud) }
		data-voice-autosend-value={ BoolFlag(d.Current.Conv.VoiceAutoSend) }
		data-voice-stop-value={ p.T("chat.voice_stop") }
		data-voice-mic-value={ p.T("chat.voice_mic") }
		hx-post={ fmt.Sprintf("/conversations/%d/messages", d.Current.Conv.ID) }
		hx-target="#transcript"
		hx-swap="beforeend"
	>
		<input type="hidden" name="csrf_token" value={ p.CSRF }/>
		<div class="composer-main">
			<div class="composer-chips" data-composer-target="chips" hidden></div>
			<textarea
				name="content"
				rows="1"
				maxlength="16384"
				placeholder={ p.T("chat.placeholder") }
				autofocus?={ d.Current.Autofocus }
				enterkeyhint="send"
				data-composer-target="input"
				data-action="input->composer#resize input->composer#sync"
			></textarea>
			<p class="composer-voice-status" data-voice-target="status" hidden></p>
		</div>
		if d.Current.SearchAvail {
			<div class="search-picker" role="group" aria-label={ p.T("chat.web_search") + ", " + p.T("chat.deep_search") }>
				<label class="search-option" title={ p.T("chat.web_search") }>
					<input
						type="checkbox"
						name="web"
						value="1"
						checked?={ d.Current.SearchOn }
					/>
					<span class="search-pill">
						<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.4" fill="none" stroke="currentColor" stroke-width="1.3"></circle><path d="M2.6 8h10.8M8 2.6c-3.6 3.5-3.6 7.3 0 10.8M8 2.6c3.6 3.5 3.6 7.3 0 10.8" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg>
						<span>{ p.T("chat.web") }</span>
					</span>
				</label>
				<label class="search-option" title={ p.T("chat.deep_search") }>
					<input
						type="checkbox"
						name="deep"
						value="1"
						checked?={ d.Current.DeepOn }
					/>
					<span class="search-pill">
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.4 13.6 5.4 8 8.4 2.4 5.4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path><path d="M2.4 8.4 8 11.4l5.6-3M2.4 10.9 8 13.9l5.6-3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
						<span>{ p.T("chat.deep") }</span>
					</span>
				</label>
			</div>
		}
		<label class="icon-btn attach-btn" title={ p.T("chat.attach") }>
			<input
				type="file"
				name="files[]"
				accept="image/*,.pdf,application/pdf,.docx,.pptx,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation"
				multiple
				class="sr-only"
				data-composer-target="file"
				data-action="change->composer#picked"
			/>
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5.2 11.4 10 6.6a2 2 0 0 1 2.8 2.8l-5.5 5.5a4 4 0 0 1-5.6-5.6l6.3-6.3a3.2 3.2 0 0 1 4.5 4.5L7.2 12.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			<span class="sr-only">{ p.T("chat.attach") }</span>
		</label>
		<button
			type="button"
			class="icon-btn mic-btn"
			title={ p.T("chat.voice_mic") }
			data-action="click->voice#toggle"
			data-voice-target="mic"
		>
			<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="6" y="1.6" width="4" height="7.2" rx="2" fill="none" stroke="currentColor" stroke-width="1.3"></rect><path d="M3.8 7.4a4.2 4.2 0 0 0 8.4 0M8 11.6v2.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
			<span class="sr-only">{ p.T("chat.voice_mic") }</span>
		</button>
		<button type="submit" class="btn-primary" data-composer-target="submit">{ p.T("chat.send") }</button>
	</form>
}
